{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Reactive Resume",
	"version": "0.1.0",
	"identifier": "dev.reactivresume.desktop",
	"build": {
		"beforeDevCommand": "node -e \"process.exit(0)\"",
		"devUrl": "http://127.0.0.1:47821",
		"beforeBuildCommand": "pnpm --dir ../web build",
		"frontendDist": "../../web/dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"resources": {
			"../../web/dist": "web/"
		}
	}
}
